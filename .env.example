# Public app URL (used for metadata, share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL (Prisma)
# Docker (docker-compose.yml): postgresql://medical:medical@localhost:5432/medical_blog?schema=public
# Override Docker credentials with POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB.
# Hosted databases (production): append &sslmode=require to enforce TLS.
# Local Postgres (Homebrew): adjust USER — example:
DATABASE_URL=postgresql://mj@localhost:5432/medical_blog?schema=public

# Optional: seed admin password (dev only — change in production)
# SEED_ADMIN_PASSWORD=ChangeMe-Dev-Only!

# Authentication (required). Generate with: openssl rand -base64 48
# Min 16 chars in development, 32 in production. Validated at startup by src/config/env.ts.
AUTH_SECRET=replace-with-output-of-openssl-rand-base64-48

# CI only: set to 1 to build without real secrets (skips env validation)
# SKIP_ENV_VALIDATION=1

# Optional: transactional email (password reset)
# EMAIL_FROM="VitalNotes <onboarding@resend.dev>"
# RESEND_API_KEY=re_xxxxxxxx

# Optional: object storage for article images
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Optional: rate limiting (newsletter, login)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
