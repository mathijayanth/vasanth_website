# Public app URL (used for metadata, share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL (Prisma)
# Docker (docker-compose.yml): postgresql://medical:medical@localhost:5432/medical_blog?schema=public
# Local Postgres (Homebrew): adjust USER — example:
DATABASE_URL=postgresql://mj@localhost:5432/medical_blog?schema=public

# Optional: seed admin password (dev only — change in production)
# SEED_ADMIN_PASSWORD=ChangeMe-Dev-Only!

# Authentication (required for protected API routes & sessions)
AUTH_SECRET=generate-a-long-random-string-min-16-chars

# Optional: transactional email (password reset)
# EMAIL_FROM="VitalNotes <onboarding@resend.dev>"
# RESEND_API_KEY=re_xxxxxxxx

# Optional: object storage for article images
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Optional: rate limiting (newsletter, login)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
