generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
  AUTHOR
  USER
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NewsletterStatus {
  ACTIVE
  UNSUBSCRIBED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  role         UserRole @default(USER)
  /// Incremented to revoke every session token issued for this user.
  sessionVersion Int    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  authorProfile AuthorProfile?
  savedArticles SavedArticle[]
  comments      Comment[]
  articleViews  ArticleView[]
  passwordResetTokens PasswordResetToken[]

  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuthorProfile {
  id          String   @id @default(cuid())
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  slug        String   @unique
  displayName String
  bio         String?
  title       String?
  specialty   String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles        Article[]
  medicalReviews  MedicalReview[]

  @@index([slug])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]

  @@index([slug])
}

model Tag {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  articleTags ArticleTag[]

  @@index([slug])
}

model Article {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  excerpt          String
  content          Json
  featuredImage    String?
  featuredImageAlt String?
  status           ArticleStatus @default(DRAFT)
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  authorId         String
  author           AuthorProfile @relation(fields: [authorId], references: [id], onDelete: Restrict)
  publishedAt      DateTime?
  readingTime      Int           @default(0)
  seoTitle         String?
  seoDescription   String?
  lastReviewedAt   DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tags           ArticleTag[]
  views          ArticleView[]
  savedBy        SavedArticle[]
  comments       Comment[]
  medicalReviews MedicalReview[]
  references     Reference[]

  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@index([authorId])
  @@index([publishedAt])
  @@index([status, publishedAt])
  @@index([categoryId, status, publishedAt])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@index([articleId])
}

model ArticleView {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  viewedAt  DateTime @default(now())
  ipHash    String?

  @@index([articleId])
  @@index([userId])
  @@index([viewedAt])
}

model SavedArticle {
  userId    String
  articleId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  savedAt   DateTime @default(now())

  @@id([userId, articleId])
  @@index([userId])
  @@index([articleId])
}

model NewsletterSubscriber {
  id             String           @id @default(cuid())
  email          String           @unique
  status         NewsletterStatus @default(ACTIVE)
  subscribedAt   DateTime         @default(now())
  unsubscribedAt DateTime?

  @@index([status])
}

model Enquiry {
  id           String        @id @default(cuid())
  name         String        @db.VarChar(120)
  organization String?       @db.VarChar(160)
  email        String        @db.VarChar(254)
  phone        String?       @db.VarChar(40)
  service      String        @db.VarChar(80)
  details      String        @db.VarChar(5000)
  timeline     String?       @db.VarChar(120)
  status       EnquiryStatus @default(NEW)
  createdAt    DateTime      @default(now())

  @@index([status, createdAt])
  @@index([email])
}

model Comment {
  id        String        @id @default(cuid())
  articleId String
  article   Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  status    CommentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([articleId])
  @@index([userId])
  @@index([status])
}

model MedicalReview {
  id         String        @id @default(cuid())
  articleId  String
  article    Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   AuthorProfile @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewedAt DateTime      @default(now())
  note       String?
  isVerified Boolean       @default(false)

  @@index([articleId])
  @@index([reviewerId])
  @@index([reviewedAt])
}

model Reference {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  label     String
  href      String?
  sortOrder Int     @default(0)

  @@index([articleId])
}
